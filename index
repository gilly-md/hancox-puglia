const plus = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>`;
const pin = `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>`;

const container = document.getElementById("days");
days.forEach((d,i)=>{
  const el = document.createElement("article");
  el.className = "day";
  el.style.animationDelay = (0.05 + i*0.05) + "s";
  el.innerHTML = `
    <div class="day-top">
      <div class="daynum"><span class="n">${d.n}</span><span class="l">${d.dow} · ${d.date}</span></div>
      <div class="day-main">
        <h3>${d.title}</h3>
        <div class="chips">
          <span class="chip base">📍 ${d.base}</span>
          <span class="chip cost">${d.cost} / day</span>
        </div>
      </div>
      <div class="day-toggle" aria-hidden="true">${plus}</div>
    </div>
    <div class="detail-wrap"><div class="detail"><div class="detail-inner">
      <div class="block"><div class="ico route">🧭</div><div>
        <div class="label">Route &amp; timeline</div><p>${d.route}</p>
        <a class="maplink" target="_blank" rel="noopener" href="${M(d.place)}">${pin} ${d.place} · open in Maps</a>
      </div></div>
      <div class="block"><div class="ico food">🍝</div><div>
        <div class="label">Where to eat</div><p>${d.food}</p>
        <a class="maplink" target="_blank" rel="noopener" href="${M(d.foodMap)}">${pin} Find on Maps</a>
      </div></div>
      <div class="block rain"><div class="ico rain">🌧️</div><div>
        <div class="label">Bad-weather backup</div><p>${d.rain}</p>
      </div></div>
    </div></div></div>`;
  el.querySelector(".day-top").addEventListener("click", ()=> el.classList.toggle("open"));
  container.appendChild(el);
});
</script>
